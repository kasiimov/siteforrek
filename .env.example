# Nace Drex — ключ создаётся в консоли: https://console.nace.ai/docs/drex/quickstart
# Живёт только на сервере (воркер deploy/worker.js), в браузерный бандл не попадает.
NACE_API_KEY=

# Админка (воркер admin/worker.js). Если задать ADMIN_PASSWORD,
# панель закрывается паролем и подписанной cookie-сессией на 7 дней.
# ADMIN_SECRET — отдельный ключ подписи (необязательно, по умолчанию берётся пароль).
# Без ADMIN_PASSWORD вход остаётся открытым, как на превью.
ADMIN_PASSWORD=
ADMIN_SECRET=
